# Linux 0.11 —— clang-format 配置（对齐 Linus 1991 年的写法）
#
# 基准：Linux 内核编码风格（Documentation/process/coding-style.rst），
# 并按原始 0.11 源码的实际习惯做了两处修正：
#   * PointerAlignment: Middle —— 原版是 `struct m_inode * inode`，
#     而不是现代内核的 `struct m_inode *inode`（fs/namei.c 58:0、fs/inode.c 25:0）
#   * SpaceBeforeParens: ControlStatements —— `if (x)` 有空格，`foo(x)` 没有
#
# clang-format 复现不了的两条 1991 年习惯（它没有对应选项，写死为现代写法）：
#   * 逗号后不加空格：原版 `memset(inode,0,sizeof(*inode));` → 会被改成 `inode, 0, ...`
#   * 二元运算符两侧不加空格：原版 `i<8`、`j+i*8192` → 会被改成 `i < 8`、`j + i * 8192`
# 想要连这两条也一致，只能用 astyle（--pad-oper/-p 关闭、--pad-comma/-xg 关闭）。
#
# 用法：
#   clang-format -i <file>              格式化单个文件
#   git clang-format                    只格式化本次改动的行
#   clang-format --dry-run -Werror <f>  只检查、不修改
#
# ★ 版本要求：clang-format **21.1.8**
#
# clang-format 的输出跟版本绑定：同一份配置，18.1.3 与 21.1.8 会在 41 个文件上
# 产生差异（多行宏的续行对齐、行尾注释用 TAB 还是空格、宏体折行方式）。
# 本仓库以 21.1.8 为准 —— 它和 VS Code clangd 扩展 21.1.8 内置的 clang-format 一致，
# 所以在编辑器里按格式化键不会再把文件改乱（前提是编辑器也用 21.1.8）。
# 换版本前请先全仓对齐一次，否则每按一次格式化都会产生无意义的改动。
#
# 注意：boot/*.s、kernel/system_call.s、mm/page.s、kb.S、rs_io.s 是 GNU as 汇编，
# 不能喂给 clang-format（它按 C/C++ 解析会把汇编改坏）。只格式化 *.c / *.h。
#
# 下面这些 Linus 的规矩 clang-format 管不了，只能靠自觉：
#   * 缩进用 TAB，宽度就是 8（不是 4，更不是空格）
#   * 单条语句不加花括号；缩进超过 3 层就该重构了
#   * 函数要短小，只做一件事
#   * 不要用 typedef 给结构体/指针起别名（_t 是给不透明类型留的）
#   * 变量名要短：cnt、i、tmp，不用 ThisIsALocalVariable
#   * 注释写"为什么"，不写"是什么"
#   * 注释用 C89 的 /* */ ，不用 C99 的 //（本仓库的 // 多为中文补注，属历史遗留）
---
Language: Cpp
BasedOnStyle: LLVM

AccessModifierOffset: -4
AlignAfterOpenBracket: Align
AlignConsecutiveAssignments: None
AlignConsecutiveDeclarations: None
AlignConsecutiveMacros: None
AlignEscapedNewlines: Left
AlignOperands: Align
AlignTrailingComments: true
AllowShortCaseLabelsOnASingleLine: false
AllowShortEnumsOnASingleLine: false
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowAllArgumentsOnNextLine: false
AllowAllParametersOfDeclarationOnNextLine: false
AlwaysBreakAfterReturnType: None
AlwaysBreakBeforeMultilineStrings: false
BinPackArguments: false
BinPackParameters: false

# 花括号：函数/结构体/枚举的 { 另起一行，控制语句的 { 留在本行（K&R）
BreakBeforeBraces: Custom
BraceWrapping:
  AfterCaseLabel: false
  AfterClass: true
  AfterControlStatement: Never
  AfterEnum: true
  AfterFunction: true
  AfterNamespace: false
  AfterStruct: true
  AfterUnion: false
  AfterExternBlock: true
  BeforeCatch: false
  BeforeElse: false
  IndentBraces: false
  SplitEmptyFunction: false
  SplitEmptyRecord: false
  SplitEmptyNamespace: false

BreakBeforeBinaryOperators: None
BreakBeforeTernaryOperators: false
# 不要拆字符串字面量——源码里有大量 __asm__("...\n\t" "...") 拼接
BreakStringLiterals: false
ColumnLimit: 80
DerivePointerAlignment: false
IndentCaseLabels: false
IndentGotoLabels: false
IndentPPDirectives: None
IndentWidth: 8
IndentWrappedFunctionNames: false
KeepEmptyLinesAtTheStartOfBlocks: false
MaxEmptyLinesToKeep: 1

# 换行代价：尽量把行压满 80 列，别急着折行（内核同款）
PenaltyBreakAssignment: 2
PenaltyBreakBeforeFirstCallParameter: 1
PenaltyExcessCharacter: 1000000
PenaltyReturnTypeOnItsOwnLine: 60

# 原版 0.11 是 `struct inode * inode`（两边都留空格）
PointerAlignment: Middle
# 不要重排注释内容：中文注释被重排会很难看
ReflowComments: false
# include 次序由作者手工维护，工具不要插手
SortIncludes: false
SpaceAfterCStyleCast: false
SpaceBeforeAssignmentOperators: true
SpaceBeforeParens: ControlStatements
SpaceBeforeSquareBrackets: false
TabWidth: 8
UseTab: Always

# 注：内核 .clang-format 里还有 ForEachMacros / StatementMacros /
# WhitespaceSensitiveMacros 三张表，用来保护内核自己的宏。0.11 里没有这类宏，
# 唯一的候选是 lib/*.c 的 _syscall0~3（会被规范化成 _syscall1(int, close, int, fd)），
# 实测 WhitespaceSensitiveMacros 对它无效，且改动无害，故不列。
